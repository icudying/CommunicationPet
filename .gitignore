# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# --- Node / Electron ---
node_modules/
electron-app/node_modules/
electron-app/dist/
dist/
build/compiled-backend/
build/compiled-backend-temp/
.cb/

# --- Local configuration and secrets ---
.env
.env.*
!.env.example
*.local
*.pem

# --- Runtime data (conversation history, memory vault, databases) ---
runtime/data/
runtime/memory_vault/
runtime/*.db
runtime/*.db-wal
runtime/*.db-shm
runtime/*.zip
runtime/mem0/
runtime/python/*
!runtime/python/.gitkeep
!runtime/README.md
!runtime/.gitkeep

# --- Downloaded models / third-party runtimes ---
assets/**
!assets/
!assets/.gitkeep
distribution-assets/
vendor/
model/SenseVoiceSmall/model.pt
llm-module/llama/bin/*.dll
llm-module/llama/bin/*.exe

# --- Logs and local dev artifacts ---
logs/
*.log
*.tmp
.nested-git-backups/

# --- Editors / OS ---
.DS_Store
Thumbs.db
.vscode/
.cursor/
.idea/
.claude/
.specstory/
