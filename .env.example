# Reference template. The app reads these from the process environment
# (the LLM key can also be entered in Settings). It does not auto-load .env;
# export them in your shell or use 一键启动.bat. Never commit real secrets.

# --- LLM (any OpenAI-compatible chat-completions API) ---
MINIMIND_LLM_API_KEY=
MINIMIND_LLM_BASE_URL=https://api.deepseek.com
MINIMIND_LLM_MODEL=deepseek-chat

# --- Python / model paths ---
# Leave MINIMIND_PYTHON empty to let the app auto-detect.
MINIMIND_PYTHON=
MINIMIND_GSV_ROOT=
MINIMIND_ASR_MODEL_PATH=
MINIMIND_VAD_MODEL_PATH=
MINIMIND_GPTSOVITS_URL=http://127.0.0.1:9880

# --- Optional features (0 = off) ---
MINIMIND_MEMORY_ENABLED=0
MINIMIND_MOTION_ENABLED=0
MINIMIND_HAST_ENABLED=0
MINIMIND_HAST_ROOT=
